{
  "name": "frontend-organization-portal",
  "version": "1.41.1",
  "private": true,
  "description": "Frontend for Contact Hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblod/frontend-organization-portal.git"
  },
  "license": "MIT",
  "author": "redpencil.io",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "release": "release-it",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test"
  },
  "overrides": {
    "@lblod/ember-environment-banner": {
      "@appuniversum/ember-appuniversum": "^4.2.2",
      "ember-source": "$ember-source"
    },
    "ember-resources": {
      "ember-concurrency": "^5.2.0"
    }
  },
  "devDependencies": {
    "@appuniversum/ember-appuniversum": "^4.2.2",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@ember/optional-features": "^2.3.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^3.9.3",
    "@embroider/core": "^3.5.9",
    "@embroider/macros": "^1.20.2",
    "@embroider/router": "^2.1.8",
    "@embroider/webpack": "^4.1.2",
    "@eslint/js": "^9.39.4",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.8.14",
    "@glint/template": "^1.7.8",
    "@lblod/ember-acmidm-login": "^2.1.0",
    "@lblod/ember-address-search": "^1.0.0",
    "@lblod/ember-environment-banner": "^0.5.0",
    "@lblod/ember-mock-login": "^0.14.0",
    "@lblod/ember-rdfa-editor": "^13.0.0",
    "@release-it-plugins/lerna-changelog": "^6.1.0",
    "@triply/yasgui": "^4.2.20",
    "@tsconfig/ember": "^3.0.12",
    "@types/qunit": "^2.19.13",
    "@types/rsvp": "^4.0.9",
    "@warp-drive/core": "~5.8.1",
    "@warp-drive/ember": "~5.8.1",
    "@warp-drive/json-api": "~5.8.1",
    "@warp-drive/legacy": "~5.8.1",
    "@warp-drive/utilities": "~5.8.1",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.1",
    "ember-auto-import": "^2.13.1",
    "ember-basic-dropdown": "^8.11.1",
    "ember-breadcrumb-trail": "^2.0.0",
    "ember-cli": "~6.12.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-dependency-lint": "^2.0.0",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^11.0.1",
    "ember-concurrency": "^5.2.0",
    "ember-config-helper": "^0.1.3",
    "ember-intl": "^7.5.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-power-select": "^8.0.0",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-resources": "^6.0.0",
    "ember-simple-auth": "^8.3.1",
    "ember-source": "~6.12.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^6.1.0",
    "ember-truth-helpers": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.8.1",
    "globals": "^15.15.0",
    "joi": "17.11",
    "loader.js": "^4.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.4",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "release-it": "^17.1.1",
    "sass": "^1.49.7",
    "sinon": "^17.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "webpack": "^5.106.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  }
}
