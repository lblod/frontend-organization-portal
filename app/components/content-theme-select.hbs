<div class={{if @error "ember-power-select--error"}}>
  <PowerSelectMultiple
    @loadingMessage="Aan het laden..."
    @noMatchesMessage="Geen resultaten"
    @searchEnabled={{true}}
    @searchField="label"
    @closeOnSelect={{false}}
    @options={{this.loadContentThemesTask.last}}
    @selected={{@selected}}
    @onChange={{@onChange}}
    @triggerId={{@id}}
    as |contentTheme|
  >
    {{contentTheme.label}}
  </PowerSelectMultiple>
</div>
