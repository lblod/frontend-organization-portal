<AuModal @modalOpen={{true}} @closeModal={{@onCancel}}>
  <:title>{{@title}}</:title>
  <:body>{{@message}}</:body>
  <:footer>
    <AuToolbar @reverse={{true}} as |Group|>
      <Group>
        <AuButton
          @skin="secondary"
          {{on "click" @onCancel}}
        >Annuleren</AuButton>
        <AuButton
          @alert={{true}}
          @icon="bin"
          @iconAlignment="left"
          {{on "click" @onConfirm}}
        >Relatie verwijderen</AuButton>
      </Group>
    </AuToolbar>
  </:footer>
</AuModal>{{yield}}